# ---------------------------------------------------------------------------
# Shared environment configuration. Copy to .env at the repo root (used by
# docker-compose) and/or apps/api/.env and apps/web/.env for local dev.
# ---------------------------------------------------------------------------

# ---- Database ----
POSTGRES_USER=cricket_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cricket_platform
DATABASE_URL=postgresql://cricket_admin:change_me_in_production@localhost:5432/cricket_platform?schema=public

# ---- API ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call the API with credentials.
# REQUIRED in production — cors() throws at boot if this is unset while
# NODE_ENV=production, rather than silently sending no ACAO header at all.
ALLOWED_ORIGINS=https://app.example.com

# JWT — generate real values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_real_openssl_rand_hex_32_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_hex_32_secret_min_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Independent from JWT_ACCESS_SECRET on purpose — falls back to it if unset,
# but set this explicitly in production (openssl rand -hex 32).
OTP_HASH_PEPPER=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=5

# File storage (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMS/OTP provider (console | twilio | msg91)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp provider (console | meta_cloud_api)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Payments (optional — Razorpay, used for paid tournament entries)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Distinct from RAZORPAY_KEY_SECRET — this signs webhook deliveries and is
# configured separately in the Razorpay dashboard under Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ---- Web ----
VITE_API_BASE_URL=http://localhost:4000/api/v1
